---
/*
  PROTOTYPE: Community-managerens kontrollpanel
  (docs/forslag-b2b-community-os.md). Viser foreslåtte koblinger,
  introduksjoner under oppfølging og hva som trenger oppmerksomhet.
  Statisk mockup - knappene gjør ingenting, tallene er eksempler.
*/
import InternLayout from '@layouts/InternLayout.astro';
import { koblinger, behov, finnBedrift } from '@/data/intern';

const stats = [
  { tall: '42', label: 'Medlemmer' },
  { tall: String(behov.length), label: 'Aktive behov og tilbud' },
  { tall: String(koblinger.length), label: 'Koblinger i arbeid' },
  { tall: '2', label: 'Avtaler inngått i år' },
];

const forslag = koblinger.filter((k) => k.status === 'Introduksjon foreslått');
const oppfolging = koblinger.filter((k) => k.status !== 'Introduksjon foreslått');

const statuskjede = [
  'Introduksjon foreslått',
  'Introduksjon akseptert',
  'Møte avtalt',
  'Mulighet identifisert',
  'Tilbud sendt',
  'Samarbeid startet',
  'Avtale inngått',
];

const oppmerksomhet = [
  {
    type: 'Ny i huset',
    hva: 'Emil Hovland (Nabolab AS) har ikke fått sin første introduksjon ennå.',
    handling: 'Foreslå kaffemøte',
  },
  {
    type: 'Ufullstendig profil',
    hva: 'A til Å Regnskap og Lørenskog i Utvikling mangler intensjonsprofil («Dette ser vi etter»).',
    handling: 'Send påminnelse',
  },
  {
    type: 'Ubesvart behov',
    hva: '«Regnskapskonsulent på deltid» (A til Å Regnskap) har stått uten svar i 6 dager.',
    handling: 'Finn kandidater',
  },
  {
    type: 'Lite aktiv',
    hva: 'Brectus har ikke vært innlogget på tre uker.',
    handling: 'Ta en prat',
  },
];

const roller = [
  { navn: 'Lius vertskap', rolle: 'Hovedadministrator / community-manager', initialer: 'LI', farge: 2 },
  { navn: 'Ingrid Bakken', rolle: 'Moderator', initialer: 'IB', farge: 4 },
  { navn: 'Vilde Aas', rolle: 'Moderator', initialer: 'VA', farge: 1 },
  { navn: 'Even Sandmo', rolle: 'Moderator', initialer: 'ES', farge: 3 },
];
---

<InternLayout title="Kontrollpanel" active="admin">
  <div class="container-content admin-shell">
    <header class="admin-head">
      <h1>Community-managerens kontrollpanel</h1>
      <p>
        Verktøyet som gjør fasiliteringen effektiv: hvem bør kobles, hvilke
        introduksjoner skal følges opp, og hvem trenger et dytt. Systemet
        foreslår - community-manageren vurderer og introduserer.
      </p>
    </header>

    <ul class="stat-grid">
      {stats.map((s) => (
        <li class="intern-card stat">
          <span class="stat-tall">{s.tall}</span>
          <span class="stat-label">{s.label}</span>
        </li>
      ))}
    </ul>

    <div class="admin-cols">
      <div class="admin-main">
        <section class="intern-card admin-section">
          <h2>Foreslåtte koblinger</h2>
          <p class="section-note">
            Systemet har funnet mulige matcher ut fra behov, tilbud og
            intensjonsprofiler. Godkjenner du, får begge parter en kort
            begrunnelse og kan takke ja til introduksjonen.
          </p>
          <ul class="match-list">
            {forslag.map((k) => {
              const a = finnBedrift(k.parter[0]);
              const b = finnBedrift(k.parter[1]);
              return (
                <li>
                  <div class="match-parties">
                    <span class={`avatar avatar-sm avatar-t${a?.farge}`}>{a?.initialer}</span>
                    <span class="match-x" aria-hidden="true">×</span>
                    <span class={`avatar avatar-sm avatar-t${b?.farge}`}>{b?.initialer}</span>
                    <p class="match-names">{a?.navn} og {b?.navn}</p>
                  </div>
                  <p class="match-why">{k.hvorfor}</p>
                  <div class="queue-actions" aria-hidden="true">
                    <span class="btn btn-primary btn-sm">Foreslå introduksjon</span>
                    <span class="btn btn-ghost btn-sm">Ikke relevant nå</span>
                  </div>
                </li>
              );
            })}
          </ul>
        </section>

        <section class="intern-card admin-section">
          <h2>Introduksjoner under oppfølging</h2>
          <ul class="follow-list">
            {oppfolging.map((k) => {
              const a = finnBedrift(k.parter[0]);
              const b = finnBedrift(k.parter[1]);
              const steg = statuskjede.indexOf(k.status);
              return (
                <li>
                  <div class="follow-head">
                    <p class="match-names">{a?.navn} og {b?.navn}</p>
                    <span class="follow-status">{k.status}</span>
                  </div>
                  <div class="follow-track" role="img" aria-label={`Status: ${k.status}`}>
                    {statuskjede.map((_, i) => (
                      <span class:list={['follow-dot', { 'is-done': i <= steg }]}></span>
                    ))}
                  </div>
                </li>
              );
            })}
          </ul>
          <p class="admin-note">
            Statuskjeden er frivillig for partene: introduksjon foreslått,
            akseptert, møte avtalt, mulighet identifisert, tilbud sendt,
            samarbeid startet, avtale inngått. Vertskapet ser aggregerte tall,
            ikke salgsdetaljer.
          </p>
        </section>
      </div>

      <div class="admin-side">
        <section class="intern-card admin-section">
          <h2>Trenger oppmerksomhet</h2>
          <ul class="queue">
            {oppmerksomhet.map((item) => (
              <li>
                <div class="queue-body">
                  <span class="intern-chip">{item.type}</span>
                  <p class="queue-text">{item.hva}</p>
                </div>
                <div class="queue-actions" aria-hidden="true">
                  <span class="btn btn-ghost btn-sm">{item.handling}</span>
                </div>
              </li>
            ))}
          </ul>
        </section>

        <section class="intern-card admin-section">
          <h2>Roller</h2>
          <ul class="role-list">
            {roller.map((r) => (
              <li>
                <span class={`avatar avatar-sm avatar-t${r.farge}`}>{r.initialer}</span>
                <div>
                  <p class="role-name">{r.navn}</p>
                  <p class="role-meta">{r.rolle}</p>
                </div>
              </li>
            ))}
          </ul>
          <p class="admin-note">
            Hver bedrift har i tillegg en kontaktperson som mottar
            forespørsler og introduksjoner, og som redigerer bedriftens
            egen side.
          </p>
        </section>
      </div>
    </div>
  </div>
</InternLayout>

<style>
  .admin-shell {
    padding-block: clamp(1.5rem, 1rem + 2vw, 3rem);
  }
  .admin-head h1 { margin-bottom: 0.5rem; }
  .admin-head p { color: var(--color-fg-muted); max-width: 62ch; }

  .stat-grid {
    list-style: none;
    margin: 1.5rem 0 2rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  @media (min-width: 800px) { .stat-grid { grid-template-columns: repeat(4, 1fr); } }
  .stat-grid > li { max-width: none; }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.25rem 1.5rem;
  }
  .stat-tall {
    font-size: var(--heading-h2);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .stat-label {
    font-size: var(--text-s);
    color: var(--color-fg-muted);
  }

  .admin-cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    align-items: start;
  }
  @media (min-width: 960px) {
    .admin-cols { grid-template-columns: minmax(0, 1fr) 22rem; gap: 1.5rem; }
  }
  .admin-main, .admin-side {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-width: 0;
  }

  .admin-section { padding: 1.5rem; }
  .admin-section h2 {
    font-size: var(--heading-h4);
    margin-bottom: 1rem;
  }
  .section-note {
    font-size: var(--text-s);
    color: var(--color-fg-muted);
    margin: -0.5rem 0 1rem;
  }

  /* -- Foreslåtte koblinger ---------------------------------------------- */
  .match-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .match-list > li {
    padding-block: 1rem;
    max-width: none;
  }
  .match-list > li + li { border-top: 1px solid var(--color-line-soft); }
  .match-parties {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .match-x { color: var(--color-fg-muted); font-weight: 600; }
  .match-names {
    margin: 0 0 0 0.35rem;
    font-weight: 600;
    font-size: var(--text-s);
  }
  .match-why {
    margin: 0 0 0.85rem;
    font-size: var(--text-s);
    color: var(--color-fg-muted);
  }
  .queue-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .btn-sm { padding: 0.45rem 0.95rem; min-height: 0; font-size: var(--text-s); }

  /* -- Oppfølging ---------------------------------------------------------- */
  .follow-list {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .follow-list > li { max-width: none; }
  .follow-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }
  .follow-head .match-names { margin: 0; }
  .follow-status {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-ink-2);
  }
  .follow-track {
    display: flex;
    gap: 0.35rem;
  }
  .follow-dot {
    flex: 1;
    height: 0.35rem;
    border-radius: var(--radius-pill);
    background: var(--color-line-soft);
  }
  .follow-dot.is-done { background: var(--color-accent); }
  .admin-note {
    margin: 0;
    font-size: var(--text-s);
    color: var(--color-fg-muted);
  }

  /* -- Trenger oppmerksomhet ---------------------------------------------- */
  .queue {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .queue > li {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-block: 1rem;
    max-width: none;
  }
  .queue > li + li { border-top: 1px solid var(--color-line-soft); }
  .queue-text { margin: 0.6rem 0 0; font-size: var(--text-s); }

  .role-list {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .role-list > li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: none;
  }
  .role-name { margin: 0; font-weight: 600; font-size: var(--text-s); }
  .role-meta { margin: 0; font-size: var(--text-xs); color: var(--color-fg-muted); }
</style>
