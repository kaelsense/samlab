---
/*
  PROTOTYPE: «Pulsen» - den interne veggen / feeden for huset.
  Statisk mockup med eksempeldata fra src/data/intern.ts.
*/
import InternLayout from '@layouts/InternLayout.astro';
import { innlegg, arrangementer, nyeMedlemmer, finnBedrift } from '@/data/intern';
---

<InternLayout title="Pulsen" active="pulsen">
  <div class="container-content feed-shell">
    <div class="feed-main">
      <header class="feed-head">
        <h1>Pulsen</h1>
        <p>Det som skjer på huset - fra folkene som jobber her.</p>
      </header>

      <!-- Skriv nytt innlegg (mock) -->
      <div class="intern-card compose" aria-hidden="true">
        <span class="avatar avatar-t2">KD</span>
        <div class="compose-field">Del noe med huset ...</div>
        <div class="compose-actions">
          <span class="intern-chip">Bilde</span>
          <span class="intern-chip">Arrangement</span>
        </div>
      </div>

      <!-- Innlegg -->
      {innlegg.map((post) => {
        const b = finnBedrift(post.bedrift);
        return (
          <article class:list={['intern-card', 'post', { 'is-pinned': post.festet }]}>
            {post.festet && <p class="post-pin">Festet av vertskapet</p>}
            <header class="post-head">
              <span class={`avatar avatar-t${post.forfatter.farge}`}>{post.forfatter.initialer}</span>
              <div class="post-who">
                <p class="post-name">{post.forfatter.navn}</p>
                <p class="post-meta">
                  {b && !post.festet && (
                    <a href={`/intern/bedrifter/${b.slug}/`}>{b.navn}</a>
                  )}
                  {b && !post.festet && <span aria-hidden="true"> · </span>}
                  <span>{post.tid}</span>
                </p>
              </div>
            </header>
            <p class="post-text">{post.tekst}</p>
            {post.bilde && (
              <figure class="post-media">
                <img src={post.bilde} alt={post.bildeAlt ?? ''} loading="lazy" />
              </figure>
            )}
            <footer class="post-foot" aria-hidden="true">
              <span class="post-action">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M7 11v9H4a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1h3Zm0 0 4-7a2 2 0 0 1 2 2v4h6a2 2 0 0 1 2 2l-1.5 7a2 2 0 0 1-2 1.5H7" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                </svg>
                Liker ({post.liker})
              </span>
              <span class="post-action">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M21 12a8 8 0 0 1-8 8H4l2-3a8 8 0 1 1 15-5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                </svg>
                Kommentarer ({post.kommentarer})
              </span>
            </footer>
          </article>
        );
      })}
    </div>

    <aside class="feed-side">
      <div class="intern-card side-card">
        <h2>Kommende på huset</h2>
        <ul class="event-list">
          {arrangementer.map((a) => (
            <li>
              <span class="event-date">{a.dato}</span>
              <div>
                <p class="event-title">{a.tittel}</p>
                <p class="event-meta">{a.sted} · {a.arrangor}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <div class="intern-card side-card">
        <h2>Nye på huset</h2>
        <ul class="people-list">
          {nyeMedlemmer.map((p) => (
            <li>
              <span class={`avatar avatar-sm avatar-t${p.farge}`}>{p.initialer}</span>
              <div>
                <p class="event-title">{p.navn}</p>
                <p class="event-meta">{p.tittel}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <div class="intern-card side-card">
        <h2>Kjøreregler</h2>
        <p class="side-text">
          Vær raus, del gjerne - og spør alltid før du legger ut bilder av
          andre. Vertskapet og moderatorene rydder ved behov.
        </p>
        <a class="side-link" href="/intern/admin/">Se retningslinjer</a>
      </div>
    </aside>
  </div>
</InternLayout>

<style>
  .feed-shell {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding-block: clamp(1.5rem, 1rem + 2vw, 3rem);
    align-items: start;
  }
  @media (min-width: 960px) {
    .feed-shell { grid-template-columns: minmax(0, 1fr) 19rem; gap: 2.5rem; }
  }

  .feed-main {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 42rem;
    width: 100%;
    margin-inline: auto;
  }
  @media (min-width: 960px) {
    .feed-main { margin-inline: 0 auto; }
  }

  .feed-head h1 { margin-bottom: 0.35rem; }
  .feed-head p { color: var(--color-fg-muted); margin: 0; }

  /* -- Compose (mock) ---------------------------------------------------- */
  .compose {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1rem 1.25rem;
    flex-wrap: wrap;
  }
  .compose-field {
    flex: 1;
    min-width: 10rem;
    padding: 0.6rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    color: var(--color-fg-muted);
    font-size: var(--text-s);
  }
  .compose-actions { display: flex; gap: 0.5rem; }

  /* -- Innlegg ------------------------------------------------------------ */
  .post {
    padding: 1.25rem 1.25rem 0.75rem;
  }
  .post.is-pinned {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 1px var(--color-accent);
  }
  .post-pin {
    margin: 0 0 0.75rem;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent-ink);
    background: var(--color-accent);
    display: inline-block;
    padding: 0.15rem 0.6rem;
    border-radius: var(--radius-pill);
  }
  .post-head {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 0.85rem;
  }
  .post-name {
    margin: 0;
    font-weight: 700;
    font-size: var(--text-m);
    line-height: 1.3;
  }
  .post-meta {
    margin: 0;
    font-size: var(--text-s);
    color: var(--color-fg-muted);
  }
  .post-meta a { color: inherit; font-weight: 600; text-decoration: none; }
  .post-meta a:hover { text-decoration: underline; }
  .post-text {
    margin: 0 0 1rem;
    max-width: none;
  }
  .post-media {
    margin: 0 0 0.5rem;
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .post-media img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .post-foot {
    display: flex;
    gap: 0.5rem;
    padding-block: 0.5rem;
    border-top: 1px solid var(--color-line-soft);
    margin-top: 0.25rem;
  }
  .post-action {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-s);
    font-weight: 600;
    color: var(--color-fg-muted);
  }
  .post-action:hover { background: var(--color-surface-2); color: var(--color-ink); }

  /* -- Sidekolonne --------------------------------------------------------- */
  .feed-side {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: sticky;
    top: 5.5rem;
  }
  .side-card { padding: 1.25rem; }
  .side-card h2 {
    font-size: var(--heading-h5);
    margin-bottom: 0.85rem;
  }
  .event-list, .people-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .event-list > li, .people-list > li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    max-width: none;
  }
  .people-list > li { align-items: center; }
  .event-date {
    flex-shrink: 0;
    font-size: var(--text-xs);
    font-weight: 700;
    background: var(--color-surface);
    color: var(--color-ink-2);
    border-radius: var(--radius-sm);
    padding: 0.3rem 0.5rem;
    white-space: nowrap;
  }
  .event-title { margin: 0; font-weight: 600; font-size: var(--text-s); line-height: 1.35; }
  .event-meta { margin: 0; font-size: var(--text-xs); color: var(--color-fg-muted); }
  .side-text { font-size: var(--text-s); color: var(--color-fg-muted); margin: 0 0 0.75rem; }
  .side-link { font-size: var(--text-s); font-weight: 600; }
</style>
