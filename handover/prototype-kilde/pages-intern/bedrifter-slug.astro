---
/*
  PROTOTYPE: Bedriftsprofil - hver bedrift sin egen seksjon i huset.
  Viser logo/profilering, historie, tjenester/produkter, ansatte,
  bildegalleri og bedriftens siste innlegg fra Pulsen.
  Statisk mockup med eksempeldata fra src/data/intern.ts.
*/
import InternLayout from '@layouts/InternLayout.astro';
import { bedrifter, innlegg, intensjoner, behov, type Bedrift } from '@/data/intern';

export function getStaticPaths() {
  return bedrifter.map((b) => ({ params: { slug: b.slug }, props: { bedrift: b } }));
}

interface Props {
  bedrift: Bedrift;
}
const { bedrift } = Astro.props;
const egneInnlegg = innlegg.filter((p) => p.bedrift === bedrift.slug && !p.festet);
const intensjon = intensjoner[bedrift.slug];
const egneBehov = behov.filter((n) => n.bedrift === bedrift.slug);
---

<InternLayout title={bedrift.navn} active="bedrifter">
  <!-- Profil-topp -->
  <section class="profile-hero">
    <div class="container-content">
      <nav class="profile-crumb" aria-label="Brødsmulesti">
        <a href="/intern/bedrifter/">Bedrifter</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{bedrift.navn}</span>
      </nav>

      <div class="profile-head intern-card">
        <div class="profile-logo">
          {bedrift.logo ? (
            <img src={bedrift.logo} alt={bedrift.navn} />
          ) : (
            <span class={`avatar avatar-lg avatar-t${bedrift.farge}`}>{bedrift.initialer}</span>
          )}
        </div>
        <div class="profile-id">
          <h1>{bedrift.navn}</h1>
          <p class="profile-cat">{bedrift.kategori}</p>
          <p class="profile-meta">
            {bedrift.plass}
            {bedrift.nettside && (
              <>
                <span aria-hidden="true"> · </span>
                <a href={bedrift.nettside} rel="noopener" target="_blank">Nettside</a>
              </>
            )}
            {bedrift.fiktiv && (
              <>
                <span aria-hidden="true"> · </span>
                <span class="profile-fiktiv">Fiktiv eksempelbedrift</span>
              </>
            )}
          </p>
        </div>
        <div class="profile-actions" aria-hidden="true">
          <span class="btn btn-primary">Send forespørsel</span>
          <span class="btn btn-ghost">Book rådgivningsmøte</span>
        </div>
      </div>
    </div>
  </section>

  <div class="container-content profile-shell">
    <div class="profile-main">
      <!-- Om oss / historie -->
      <section class="intern-card profile-section">
        <h2>Om oss</h2>
        {bedrift.om.map((p) => <p>{p}</p>)}
      </section>

      <!-- Intensjonsprofil (B2B Community OS, kap. 1) -->
      {intensjon && (
        <section class="intern-card profile-section">
          <h2>Dette ser vi etter</h2>
          <dl class="intent-list">
            <div><dt>Dette leverer vi</dt><dd>{intensjon.leverer}</dd></div>
            <div><dt>Dette kjøper vi regelmessig</dt><dd>{intensjon.kjoper}</dd></div>
            <div><dt>Dette trenger vi hjelp med nå</dt><dd>{intensjon.trengerNa}</dd></div>
            <div><dt>Våre ideelle kunder</dt><dd>{intensjon.idealkunder}</dd></div>
          </dl>
          <div class="intent-open">
            <p>Åpne for:</p>
            {intensjon.apenFor.map((a) => <span class="intern-chip">{a}</span>)}
          </div>
        </section>
      )}

      <!-- Aktive behov og tilbud -->
      {egneBehov.length > 0 && (
        <section class="intern-card profile-section">
          <h2>Aktive behov og tilbud</h2>
          <ul class="mini-needs">
            {egneBehov.map((n) => (
              <li>
                <span class:list={['mini-need-kind', `is-${n.kategori}`]}>
                  {n.kategori === 'trenger' ? 'Trenger' : 'Tilbyr'}
                </span>
                <div>
                  <p class="mini-need-title">{n.tittel}</p>
                  <p class="mini-need-meta">
                    {n.frist ? `Frist: ${n.frist}` : 'Løpende'} · {n.kontakt}
                  </p>
                </div>
              </li>
            ))}
          </ul>
          <a class="mini-link" href="/intern/behov/">Se alle behov og tilbud</a>
        </section>
      )}

      <!-- Tjenester og produkter -->
      <section class="intern-card profile-section">
        <h2>Tjenester og produkter</h2>
        <div class="service-grid">
          {bedrift.tjenester.map((t) => (
            <div class="service-box">
              <h3>{t.tittel}</h3>
              <ul>
                {t.punkter.map((p) => <li>{p}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- Galleri -->
      <section class="intern-card profile-section">
        <h2>Bilder</h2>
        <p class="section-note">
          Bedriften laster selv opp bilder av folk, produkter og hverdagen -
          her vist med bilder fra huset.
        </p>
        <div class="gallery">
          {bedrift.bilder.map((src) => (
            <figure>
              <img src={src} alt="" loading="lazy" />
            </figure>
          ))}
        </div>
      </section>

      <!-- Siste innlegg -->
      {egneInnlegg.length > 0 && (
        <section class="intern-card profile-section">
          <h2>Siste fra Pulsen</h2>
          <ul class="mini-feed">
            {egneInnlegg.map((post) => (
              <li>
                <span class={`avatar avatar-sm avatar-t${post.forfatter.farge}`}>{post.forfatter.initialer}</span>
                <div>
                  <p class="mini-meta">{post.forfatter.navn} · {post.tid}</p>
                  <p class="mini-text">{post.tekst}</p>
                </div>
              </li>
            ))}
          </ul>
          <a class="mini-link" href="/intern/">Se alt på Pulsen</a>
        </section>
      )}
    </div>

    <aside class="profile-side">
      <section class="intern-card profile-section">
        <h2>Folkene</h2>
        <ul class="people">
          {bedrift.ansatte.map((a) => (
            <li>
              <span class={`avatar avatar-t${a.farge}`}>{a.initialer}</span>
              <div>
                <p class="people-name">{a.navn}</p>
                <p class="people-title">{a.tittel}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section class="intern-card profile-section">
        <h2>Kontaktperson</h2>
        <p class="section-note">
          {bedrift.ansatte[0].navn} er bedriftens kontaktperson og redaktør,
          og mottar forespørsler og introduksjoner på vegne av bedriften.
        </p>
      </section>
    </aside>
  </div>
</InternLayout>

<style>
  .profile-hero {
    padding-top: clamp(1.25rem, 1rem + 1.5vw, 2.5rem);
  }
  .profile-crumb {
    display: flex;
    gap: 0.5rem;
    font-size: var(--text-s);
    color: var(--color-fg-muted);
    margin-bottom: 1rem;
  }
  .profile-crumb a { color: inherit; text-decoration: none; }
  .profile-crumb a:hover { text-decoration: underline; }

  .profile-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem;
  }
  .profile-logo {
    width: 7.5rem;
    height: 7.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-line-soft);
    border-radius: var(--radius-md);
    background: var(--color-paper);
    padding: 0.75rem;
    flex-shrink: 0;
  }
  .profile-logo img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .profile-id { flex: 1; min-width: 14rem; }
  .profile-id h1 { font-size: var(--heading-h2); }
  .profile-cat {
    margin: 0.35rem 0 0;
    font-weight: 600;
    color: var(--color-ink-2);
  }
  .profile-meta {
    margin: 0.35rem 0 0;
    font-size: var(--text-s);
    color: var(--color-fg-muted);
  }
  .profile-fiktiv {
    font-weight: 600;
    color: var(--color-accent-ink);
    background: var(--color-accent);
    border-radius: var(--radius-pill);
    padding: 0.1rem 0.5rem;
    font-size: var(--text-xs);
  }
  .profile-actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .profile-shell {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    padding-block: 1.25rem clamp(2rem, 1.5rem + 2vw, 3.5rem);
    align-items: start;
  }
  @media (min-width: 960px) {
    .profile-shell { grid-template-columns: minmax(0, 1fr) 19rem; gap: 1.5rem; }
  }
  .profile-main, .profile-side {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-width: 0;
  }

  .profile-section { padding: 1.5rem; }
  .profile-section h2 {
    font-size: var(--heading-h4);
    margin-bottom: 1rem;
  }
  .profile-section p { color: var(--color-fg-muted); }
  .section-note {
    font-size: var(--text-s);
    margin-top: -0.5rem;
  }

  .service-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 680px) { .service-grid { grid-template-columns: repeat(2, 1fr); } }
  .service-box {
    border: 1px solid var(--color-line-soft);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    background: var(--color-surface-2);
  }
  .service-box h3 { font-size: var(--text-m); margin-bottom: 0.5rem; }
  .service-box ul {
    margin: 0;
    padding-left: 1.1em;
    font-size: var(--text-s);
    color: var(--color-fg-muted);
  }
  .service-box li { margin-bottom: 0.25em; }

  .gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }
  @media (min-width: 680px) { .gallery { grid-template-columns: repeat(3, 1fr); } }
  .gallery figure {
    margin: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .gallery img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .mini-feed {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .mini-feed > li {
    display: flex;
    gap: 0.75rem;
    max-width: none;
  }
  .mini-meta {
    margin: 0 0 0.25rem;
    font-size: var(--text-xs);
    color: var(--color-fg-muted);
  }
  .mini-text {
    margin: 0;
    font-size: var(--text-s);
    color: var(--color-fg);
  }
  .mini-link { font-size: var(--text-s); font-weight: 600; }

  .people {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .people > li {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    max-width: none;
  }
  .people-name { margin: 0; font-weight: 600; font-size: var(--text-s); }
  .people-title { margin: 0; font-size: var(--text-xs); color: var(--color-fg-muted); }

  .intent-list {
    margin: 0 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .intent-list dt {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-fg-muted);
    margin-bottom: 0.15rem;
  }
  .intent-list dd {
    margin: 0;
    font-size: var(--text-s);
    color: var(--color-fg);
  }
  .intent-open {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-line-soft);
  }
  .intent-open p {
    margin: 0;
    font-size: var(--text-s);
    font-weight: 600;
    color: var(--color-fg-muted);
  }

  .mini-needs {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .mini-needs > li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    max-width: none;
  }
  .mini-need-kind {
    flex-shrink: 0;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    background: var(--color-ink-2);
    color: var(--color-paper);
  }
  .mini-need-kind.is-tilbyr {
    background: var(--color-accent);
    color: var(--color-accent-ink);
  }
  .mini-need-title { margin: 0; font-weight: 600; font-size: var(--text-s); line-height: 1.35; }
  .mini-need-meta { margin: 0.15rem 0 0; font-size: var(--text-xs); color: var(--color-fg-muted); }
</style>
